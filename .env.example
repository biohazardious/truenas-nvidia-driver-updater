# .env.example — Copy to .env and edit, or run ./configure.sh to generate
#
# Required:
NVIDIA_VERSION=595.112.07
TRUENAS_VERSION=25.10.8

# Optional (defaults shown):
NVIDIA_KERNEL_MODULE_TYPE=open
# Release folder on download.truenas.com; leave empty to let the build find it.
# (Old files with TRUENAS_CODENAME=<name> still work.)
TRUENAS_TRAIN=TrueNAS-SCALE-Goldeye
NVIDIA_BUILD_CC=
NVIDIA_INSTALL_DRM=true
EMBED_NVIDIA_RAW_IN_UPDATE=false
# Set true to bypass the early driver/kernel compatibility abort (e.g. building
# a legacy driver branch with patched sources).
SKIP_KERNEL_COMPAT_CHECK=false
# Source-patch mode: none | custom | predefined | auto (default auto).
#   predefined -> curated set in predefined-patches/<driver>/ (run configure.sh)
#   custom     -> your own patches in patches/<kernel>/
NVIDIA_PATCH_MODE=auto
# GPUs the build checks the driver against (devid:subvendor:subdevice, comma
# separated; cards reserved for a VM are left out). Filled in by configure.sh
# when it runs on the TrueNAS host; empty skips the check (deploy-nvidia.sh
# still checks the host's GPUs). Set SKIP_GPU_CHECK=true to build a driver
# that does not list these cards.
NVIDIA_TARGET_GPUS=
SKIP_GPU_CHECK=false
